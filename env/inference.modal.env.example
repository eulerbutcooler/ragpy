# Modal inference profile (local or server).
#
# Generation runs on a B200 via modal_vllm.py; embeddings and reranking run on
# a small GPU via modal_embed.py. Both endpoints require the same
# INFERENCE_API_KEY that is stored in the Modal secret `aeromentor-inference`.
LLM_BASE_URL=https://<workspace>--aeromentor-vllm-vllmserver.<region>.modal.direct/v1
LLM_MODEL=aeromentor-gen
LLM_CONDENSE_MODEL=aeromentor-gen
LLM_API_KEY=replace-with-modal-inference-api-key

EMBED_BACKEND=remote
EMBED_BASE_URL=https://<workspace>--aeromentor-embed-embedserver.<region>.modal.direct/v1
RERANKER_BACKEND=remote
RERANKER_BASE_URL=https://<workspace>--aeromentor-embed-embedserver.<region>.modal.direct

# In-flight work. LLM requests = QUIZ_CONCURRENCY * TOPIC_CONCURRENCY + plans.
QUIZ_CONCURRENCY=24
TOPIC_CONCURRENCY=4
INGEST_CONCURRENCY=8
LESSON_PLAN_CONCURRENCY=12

# Embedding gateway concurrency (Modal embed app).
EMBED_CONCURRENCY=8
RERANK_CONCURRENCY=4
RERANK_BATCH_SIZE=16
EMBED_REQUEST_CONCURRENCY=16
EMBED_MAX_RETRIES=8
MAX_FIGURES_PER_FILE=400
