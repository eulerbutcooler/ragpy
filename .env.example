## Server
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

## LLM (vLLM)
LLM_BASE_URL=http://localhost:1234/v1
LLM_CONDENSE_BASE_URL=http://localhost:1234/v1
LLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_CONDENSE_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
LLM_USE_JSON_MODE=False
## Embeddings (FastEmbed & Rerank)
EMBED_MODEL_NAME=BAAI/bge-base-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

## Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=course_documents
QDRANT_VECTOR_SIZE=768

## MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_USE_SSL=false

## NATS JetStream
NATS_URL=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=
INTERNAL_TOKEN=changeme-internal-token
