## Server
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:3000"]

## Local inference (llama.cpp OpenAI-compatible server)
# The Go backend uses :8080; run llama.cpp on :8081 (or change this URL).
LLM_BASE_URL=http://localhost:8081/v1
LLM_CONDENSE_BASE_URL=
LLM_MODEL=Qwen3.5-9B-IQ4_XS.gguf
LLM_CONDENSE_MODEL=Qwen3.5-9B-IQ4_XS.gguf
LLM_API_KEY=local-dev-key
LLM_USE_JSON_MODE=false
LLM_MAX_TOKENS=6144
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=600
LLM_ENABLE_THINKING=false
LLM_CONDENSE_MAX_TOKENS=128
LLM_CONDENSE_TIMEOUT=30

## Embeddings (loaded locally)
EMBED_BACKEND=local
EMBED_BASE_URL=
EMBED_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBED_QUERY_INSTRUCTION=Represent this sentence for searching relevant passages:
EMBED_BATCH_SIZE=32
EMBED_TIMEOUT=120
# EMBED_DEVICE=cuda

## Reranker (loaded locally)
RERANKER_BACKEND=local
RERANKER_BASE_URL=
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT=120
RERANKER_MAX_TOP_N=15

## Master syllabus parsing
SYLLABUS_SECTION_PATTERNS=part b,syllabus,course outline,curriculum,topics,learning outcomes
SYLLABUS_STOP_PATTERNS=part c,administration,references,appendix,assessment,instructor

## Retrieval
RETRIEVAL_TOP_K=15
RERANKER_TOP_N=3
HYBRID_SEARCH_ENABLED=true
RRF_K=60

## Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=course_documents
QDRANT_VECTOR_SIZE=768

## MinIO (S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_USE_SSL=false

## NATS JetStream
NATS_URL=nats://localhost:4222
NATS_USER=
NATS_PASSWORD=
INTERNAL_TOKEN=changeme-internal-token
