# Copy to ragpy/.env on the server.
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://__SERVER_HOST__:3000"]

# Modal inference endpoint. Copy the deployed URL and API key from Modal.
LLM_BASE_URL=__MODAL_URL__/v1
LLM_MODEL=aeromentor-gen
LLM_CONDENSE_MODEL=aeromentor-gen
LLM_API_KEY=__MODAL_API_KEY__
LLM_USE_JSON_MODE=false
LLM_MAX_TOKENS=6144
LLM_CONTEXT_WINDOW=32768
LLM_TEMPERATURE=0.3
LLM_REQUEST_TIMEOUT=600
LLM_ENABLE_THINKING=false
LLM_CONDENSE_MAX_TOKENS=128
LLM_CONDENSE_TIMEOUT=30

# In-flight work. LLM requests = QUIZ_CONCURRENCY * TOPIC_CONCURRENCY + plans.
QUIZ_CONCURRENCY=24
TOPIC_CONCURRENCY=4
INGEST_CONCURRENCY=8
LESSON_PLAN_CONCURRENCY=12

# Modal gateway hosts GTE + BGE reranker; no local PyTorch model needed.
EMBED_BACKEND=remote
EMBED_BASE_URL=__EMBED_URL__/v1
EMBED_MODEL_NAME=Alibaba-NLP/gte-base-en-v1.5
EMBED_QUERY_INSTRUCTION=
EMBED_MAX_LENGTH=8192
EMBED_BATCH_SIZE=32
EMBED_TIMEOUT=120

RERANKER_BACKEND=remote
RERANKER_BASE_URL=__EMBED_URL__
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_TIMEOUT=120
RERANKER_MAX_TOP_N=15

SYLLABUS_SECTION_PATTERNS=part b,syllabus,course outline,curriculum,topics,learning outcomes
SYLLABUS_STOP_PATTERNS=part c,administration,references,appendix,assessment,instructor

RETRIEVAL_TOP_K=15
RERANKER_TOP_N=3
HYBRID_SEARCH_ENABLED=true
RRF_K=60

# Used by scripts/reingest_existing.py, not by the RAG service itself.
DATABASE_URL=postgres://aeromentor:aeromentor@127.0.0.1:5432/aeromentor?sslmode=disable

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=course_documents
# GTE and BGE are both 768-d, but their vectors are not interchangeable.
QDRANT_VECTOR_SIZE=768

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET=course-files

NATS_URL=nats://127.0.0.1:4222
NATS_USER=
NATS_PASSWORD=
INTERNAL_TOKEN=__RAG_INTERNAL_TOKEN__

# Embedding gateway concurrency (Modal embed app).
EMBED_CONCURRENCY=8
RERANK_CONCURRENCY=4
RERANK_BATCH_SIZE=16
